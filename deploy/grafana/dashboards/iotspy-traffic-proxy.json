{
  "__inputs": [],
  "__requires": [],
  "id": null,
  "uid": "iotspy-traffic-proxy",
  "title": "IoTSpy: Traffic & Proxy",
  "description": "Proxy request volume, per-protocol capture throughput, manipulation rule matches and breakpoint hits.",
  "tags": ["iotspy"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(iotspy_proxy_requests_total, job)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(iotspy_proxy_requests_total{job=~\"$job\"}, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Proxy Requests (rate, by protocol/status)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (protocol, status) (rate(iotspy_proxy_requests_total{job=~\"$job\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{protocol}} / {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Captures Persisted (rate, by protocol)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (protocol) (rate(iotspy_captures_total{job=~\"$job\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{protocol}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active Captures",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(iotspy_active_captures_total{job=~\"$job\", instance=~\"$instance\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Capture Queue Depth",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(iotspy_capture_queue_depth{job=~\"$job\", instance=~\"$instance\"})",
          "legendFormat": "queue depth",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Manipulation Rule Matches (rate)",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (rule_id) (rate(iotspy_rule_matches_total{job=~\"$job\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "rule {{rule_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Breakpoint Hits (rate)",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (breakpoint_id) (rate(iotspy_breakpoint_hits_total{job=~\"$job\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "breakpoint {{breakpoint_id}}",
          "refId": "A"
        }
      ]
    }
  ]
}
